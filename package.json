{
  "name": "analytics-platform",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "lint:web": "pnpm --filter web lint",
    "typecheck:web": "pnpm --filter web typecheck",
    "dev:api": "cd apps/api && uv run python -m fastapi dev main.py",
    "test:api:integration": "apps/api/scripts/test-integration.sh tests/integration/test_track.py",
    "test:api:unit": "cd apps/api && uv run pytest tests/unit",
    "test:api": "pnpm test:api:unit && pnpm test:api:integration"
  }
}
